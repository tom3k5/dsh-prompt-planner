{
  "name": "dsh-prompt-planner",
  "description": "DeepSeek Harness plugin: analyze a prompt, ask clarifying questions, improve it, decompose it into atomic tasks, rate each task's difficulty (1-5), pick the best available model + reasoning effort per task, and return an execution plan with token estimates.",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "prompt_planner_plugin.md"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "prompt",
    "prompt-planning",
    "model-routing",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom3k5/dsh-prompt-planner.git"
  },
  "bugs": {
    "url": "https://github.com/tom3k5/dsh-prompt-planner/issues"
  },
  "homepage": "https://github.com/tom3k5/dsh-prompt-planner#readme"
}
